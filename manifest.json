{
  "manifest_version": 3,
  "name": "Bookmark Finder",
  "version": "1.0.0",
  "description": "Search your bookmarks using titles, URLs and folder paths.",
  "permissions": ["bookmarks", "tabs"],
  "action": {
    "default_title": "Bookmark Search",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/bookmark_finder_16x16.png",
      "32": "images/bookmark_finder_32x32.png",
      "48": "images/bookmark_finder_48x48.png",
      "128": "images/bookmark_finder_128x128.png"
    }
  },
  "icons": {
    "16": "images/bookmark_finder_16x16.png",
    "32": "images/bookmark_finder_32x32.png",
    "48": "images/bookmark_finder_48x48.png",
    "128": "images/bookmark_finder_128x128.png"
  }
}
